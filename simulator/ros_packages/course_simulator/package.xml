<?xml version="1.0"?>
<!-- SIMULATOR ONLY. The pretend sensors and the referee. Never install this on the drone. -->
<package format="3">
  <name>course_simulator</name>
  <version>0.0.1</version>
  <description>Pretend sensors and a referee for flying the obstacle course on a laptop.</description>
  <maintainer email="team@example.com">DroneHacks team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>isaac_ros_visual_slam_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
