<?xml version="1.0"?>
<!-- SIMULATOR ONLY. The real package comes from NVIDIA and needs an NVIDIA graphics
     chip, which the Mac does not have. This stand-in has the same name and defines
     just the one message the organizers' code imports, so their code runs unchanged. -->
<package format="3">
  <name>isaac_ros_visual_slam_interfaces</name>
  <version>0.0.1</version>
  <description>Simulator stand-in holding only the VisualSlamStatus message.</description>
  <maintainer email="team@example.com">DroneHacks team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
