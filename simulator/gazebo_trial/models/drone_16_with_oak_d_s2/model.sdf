<?xml version="1.0"?>
<!--
  A drone shaped like drone 16, with our pretend OAK-D S2 depth camera on its nose.
  TRIAL ONLY, SIMULATOR ONLY. The full simulator in Gazebo flies this drone.

  "drone_16_like" is made by make_drone_16_model.py, from PX4's x500, with drone 16's motor
  positions, estimated weight and thrust. That file says where each number comes from. Its
  centre is at the model's origin: the world places the drone so that its body rests on the
  floor.

  The camera is placed the same way as in drone_with_oak_d_s2, PX4's own layout for its
  x500_depth model: 12 cm in front of the drone's centre, level with the body, and centred
  sideways, because the depth picture is worked out for the point midway between the two real
  camera eyes. We have not measured where the camera sits on drone 16.
-->
<sdf version="1.9">
  <model name="drone_16_with_oak_d_s2">
    <!-- "merge" folds the included model's parts into this one, so PX4 sees a single drone. -->
    <include merge="true">
      <uri>model://drone_16_like</uri>
    </include>

    <include merge="true">
      <uri>model://oak_d_s2_camera</uri>
      <pose>0.12 0 0 0 0 0</pose>
    </include>

    <!-- Fixes the camera rigidly to the drone's body. -->
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
