<?xml version="1.0"?>
<sdf version="1.9"><world name="gpu_probe">
<physics name="default" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>1</real_time_factor></physics>
<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
<scene><ambient>1 1 1 1</ambient></scene>
<model name="camera"><static>true</static><pose>0 0 1 0 0 0</pose><link name="link"><sensor name="depth" type="depth_camera"><always_on>true</always_on><update_rate>15</update_rate><topic>/gpu_probe/depth</topic><camera><horizontal_fov>1.2</horizontal_fov><image><width>320</width><height>240</height></image><clip><near>0.35</near><far>10</far></clip></camera></sensor></link></model>
<model name="target"><static>true</static><pose>3 0 1 0 0 0</pose><link name="link"><visual name="box"><geometry><box><size>1 2 2</size></box></geometry></visual></link></model>
</world></sdf>
