# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Onboard service runtime logs, locks, and state receipts
.onboard/

# Logs and scratch text files
*.log
combined_code.txt

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db


# Files the simulator generates when it runs. They can always be made again.
simulator/generated_files/

# Flight records copied from the drone by drone_code/collect_flight_records.sh. They can be large.
flight_records_from_drone/

# Crash dumps left by programs that crashed inside the simulator box.
/core
